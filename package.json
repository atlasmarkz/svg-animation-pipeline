{
  "name": "svg-animation-pipeline",
  "version": "1.1.2",
  "description": "End-to-end SVG animation pipeline and DeepSeek Harness plugin: layered SVG → procedural animation → frame-accurate rendering → GIF/video encoding",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.plugin.json",
    "build:core": "tsc",
    "build:plugin": "tsc -p tsconfig.plugin.json",
    "prepare": "npm run build",
    "dev": "ts-node",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "svg",
    "animation",
    "gif",
    "video",
    "puppeteer",
    "ffmpeg",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "puppeteer": "^22.15.0",
    "fluent-ffmpeg": "^2.1.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "svg-parser": "^2.0.4"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.14.12",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12"
  },
  "icon": "./assets/icon.png",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": "./plugin/dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "plugin/dist",
    "plugin/package.json",
    "cordis.patch.yml",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlasmarkz/svg-animation-pipeline.git"
  },
  "homepage": "https://github.com/atlasmarkz/svg-animation-pipeline#readme",
  "bugs": {
    "url": "https://github.com/atlasmarkz/svg-animation-pipeline/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
